/**
 * 本地运营商阻断检测 · Loon generic 脚本
 *
 * 使用: 在 Loon 的节点页面对目标执行「运营商阻断查询」
 * 
 * @Author: RavelloH, RuCu6
 * @Modifier: Gemini
 * @Updated: 2026-07-17
 *
 * ===== Loon =====
 * [Script]
 * generic script-path=https://raw.githubusercontent.com/6otho/Loon_tool/refs/heads/main/Script/Carrier-blocking-test.scripts, tag=运营商阻断查询, timeout=60, img-url=https://raw.githubusercontent.com/tugepaopao/Image-Storage/master/cartoon/Cute1/1644010.png
 */

const IP_API = "http://ip-api.com/json";
const GLOBALPING_API = "https://api.globalping.io/v1/measurements";
const REQUEST_TIMEOUT = 10000; 
const HANDSHAKE_TIMEOUT = 3000; 

// 中国三大国际出口网区映射表（物理路由同源省份群）
const GATEWAY_MAPPING = {
  // 1. 广州出口网区（华南、西南出海骨干网同源）
  "Guangdong": ["Guangdong", "Guangxi", "Fujian", "Hainan", "Jiangxi"],
  "Guangxi": ["Guangxi", "Guangdong", "Hainan", "Fujian"],
  "Fujian": ["Fujian", "Guangdong", "Jiangxi", "Zhejiang"],
  "Hainan": ["Hainan", "Guangdong", "Guangxi"],
  "Jiangxi": ["Jiangxi", "Guangdong", "Fujian", "Hunan"],
  "Hunan": ["Hunan", "Guangdong", "Hubei", "Jiangxi"],

  // 2. 上海出口网区（华东、华中出海骨干网同源）
  "Shanghai": ["Shanghai", "Zhejiang", "Jiangsu", "Anhui"],
  "Zhejiang": ["Zhejiang", "Shanghai", "Jiangsu", "Fujian"],
  "Jiangsu": ["Jiangsu", "Shanghai", "Zhejiang", "Anhui", "Shandong"],
  "Anhui": ["Anhui", "Jiangsu", "Zhejiang", "Hubei"],
  "Hubei": ["Hubei", "Hunan", "Anhui", "Jiangxi"],
  "Henan": ["Henan", "Shandong", "Hebei", "Hubei"],

  // 3. 北京出口网区（华北、东北、西北出海骨干网同源）
  "Beijing": ["Beijing", "Tianjin", "Hebei", "Shanxi", "Inner Mongolia"],
  "Tianjin": ["Tianjin", "Beijing", "Hebei", "Shandong"],
  "Hebei": ["Hebei", "Beijing", "Tianjin", "Shanxi", "Shandong"],
  "Shandong": ["Shandong", "Jiangsu", "Hebei", "Henan"],
  "Liaoning": ["Liaoning", "Jilin", "Heilongjiang", "Beijing"],
  "Jilin": ["Jilin", "Liaoning", "Heilongjiang"],
  "Heilongjiang": ["Heilongjiang", "Jilin", "Liaoning"],
  "Sichuan": ["Sichuan", "Chongqing", "Yunnan", "Guizhou"],
  "Chongqing": ["Chongqing", "Sichuan", "Guizhou", "Hubei"],
  "Yunnan": ["Yunnan", "Guizhou", "Sichuan", "Guangxi"],
  "Guizhou": ["Guizhou", "Chongqing", "Sichuan", "Yunnan"]
};

const params = typeof $environment !== "undefined" && $environment.params ? $environment.params : {};
const nodeName = params.node || "";
const nodeInfo = params.nodeInfo || {};

if (!nodeName) {
  finishError("未获取到节点名称，请长按具体节点运行此脚本。");
} else {
  run();
}

async function run() {
  try {
    const nodeType = String(nodeInfo?.type || "").toLowerCase();
    const nodeNameLower = String(nodeName).toLowerCase();
    const isUdpProtocol = 
      nodeType.includes("hysteria") || 
      nodeType.includes("hy") || 
      nodeType.includes("tuic") || 
      nodeNameLower.includes("hy2") || 
      nodeNameLower.includes("hysteria") || 
      nodeNameLower.includes("tuic");

    const [localNetZh, localNetEn] = await Promise.all([
      requestJson(`${IP_API}?lang=zh-CN`, "DIRECT").catch(() => null),
      requestJson(IP_API, "DIRECT").catch(() => null)
    ]);

    let localRegionEn = "Guangdong"; 
    if (localNetEn && localNetEn.regionName) {
      localRegionEn = cleanRegionName(localNetEn.regionName);
    } else if (localNetZh && localNetZh.regionName) {
      const zhToEn = {
        "广东": "Guangdong", "北京": "Beijing", "上海": "Shanghai", "浙江": "Zhejiang",
        "江苏": "Jiangsu", "福建": "Fujian", "四川": "Sichuan", "山东": "Shandong",
        "湖北": "Hubei", "湖南": "Hunan", "河南": "Henan", "河北": "Hebei",
        "安徽": "Anhui", "江西": "Jiangxi", "重庆": "Chongqing", "陕西": "Shaanxi"
      };
      const zhName = localNetZh.regionName.replace("省", "").replace("市", "");
      if (zhToEn[zhName]) {
        localRegionEn = zhToEn[zhName];
      }
    }

    let localTest = { reachable: false, skipped: false };
    if (isUdpProtocol) {
      localTest.skipped = true;
    } else {
      localTest = await testLocalDirectConnection(nodeInfo);
    }

    // 匹配同出口网区省份群
    const siblingRegions = GATEWAY_MAPPING[localRegionEn] || [localRegionEn];
    const testResult = await runProvinceCheck(nodeInfo, localRegionEn, siblingRegions, isUdpProtocol);

    render(localNetZh || localNetEn, localTest, testResult, isUdpProtocol, localRegionEn, siblingRegions);
  } catch (error) {
    finishError(`执行异常: ${error.message}`);
  }
}

function cleanRegionName(region) {
  if (!region) return "";
  return String(region)
    .replace(/\s*Province\s*/gi, "")
    .replace(/\s*State\s*/gi, "")
    .replace(/\s*City\s*/gi, "")
    .trim();
}

function testLocalDirectConnection(info) {
  const address = info?.address ? String(info.address) : "";
  const port = info?.port ? Number(info.port) : null;

  if (!address || !port) {
    return Promise.resolve({ reachable: false, error: "节点配置缺少 IP 或端口" });
  }

  const host = address.includes(":") && !address.startsWith("[") ? `[${address}]` : address;
  const url = `http://${host}:${port}/`;
  const startTime = Date.now();

  return new Promise((resolve) => {
    let isSettled = false;

    const timer = setTimeout(() => {
      if (!isSettled) {
        isSettled = true;
        resolve({ reachable: false, error: "TIMEOUT", ms: Date.now() - startTime });
      }
    }, HANDSHAKE_TIMEOUT);

    $httpClient.get({
      url,
      node: "DIRECT", 
      headers: { "User-Agent": "LoonLocalHandshakeTest" }
    }, (error, response, body) => {
      if (isSettled) return;
      isSettled = true;
      clearTimeout(timer);

      const ms = Date.now() - startTime;

      if (error) {
        const errStr = String(error).toLowerCase();
        if (errStr.includes("timeout") || errStr.includes("time out")) {
          resolve({ reachable: false, error: "TIMEOUT", ms });
        } else if (errStr.includes("refused")) {
          resolve({ reachable: true, error: "REFUSED", ms });
        } else {
          resolve({ reachable: true, ms });
        }
      } else {
        resolve({ reachable: true, ms });
      }
    });
  });
}

async function runProvinceCheck(info, localRegion, siblingRegions, isUdp) {
  const address = info?.address ? String(info.address) : "";
  const port = info?.port ? Number(info.port) : 443;

  let target = address;
  if (target.startsWith("[") && target.endsWith("]")) {
    target = target.slice(1, -1);
  }

  const locations = [];
  // 1. 优先放入本地省份
  locations.push({ "magic": `China Telecom + ${localRegion}`, "limit": 1 });
  locations.push({ "magic": `China Unicom + ${localRegion}`, "limit": 1 });
  locations.push({ "magic": `China Mobile + ${localRegion}`, "limit": 1 });

  // 2. 依次放入同出口网区邻近省份（邪修映射，限制在此范围内寻找可用探针）
  siblingRegions.forEach(region => {
    if (region !== localRegion) {
      locations.push({ "magic": `China Telecom + ${region}`, "limit": 1 });
      locations.push({ "magic": `China Unicom + ${region}`, "limit": 1 });
      locations.push({ "magic": `China Mobile + ${region}`, "limit": 1 });
    }
  });

  const body = {
    target: target,
    type: "ping",
    locations: locations,
    measurementOptions: {
      packets: 3
    }
  };

  if (!isUdp) {
    body.measurementOptions.protocol = "tcp";
    body.measurementOptions.port = port;
  }

  try {
    const submission = await requestJson(GLOBALPING_API, "DIRECT", "POST", body);
    if (!submission?.id) return null;
    return await pollGlobalpingResult(submission.id);
  } catch (e) {
    return null;
  }
}

async function pollGlobalpingResult(id) {
  const url = `${GLOBALPING_API}/${id}`;
  let attempts = 0;
  while (attempts < 5) {
    await wait(2000);
    const res = await requestJson(url, "DIRECT");
    if (res && res.status !== "in_progress") return res;
    attempts++;
  }
  return await requestJson(url, "DIRECT");
}

function classifyOperator(probe) {
  const asn = Number(probe.asn);
  const net = String(probe.network).toLowerCase();
  if (asn === 4134 || net.includes("telecom") || net.includes("电信")) return "ct";
  if (asn === 4837 || net.includes("unicom") || net.includes("联通")) return "cu";
  if (asn === 9808 || net.includes("mobile") || net.includes("移动")) return "cm";
  return "other";
}

function requestJson(url, node, method = "GET", body = null) {
  return new Promise((resolve, reject) => {
    const options = {
      url,
      headers: {
        Accept: "application/json",
        "User-Agent": "Mozilla/5.0 (iPhone; CPU iPhone OS 16_0 like Mac OS X) AppleWebKit/605.1.15"
      }
    };
    if (node) options.node = node;
    if (method.toUpperCase() === "POST" && body) {
      options.headers["Content-Type"] = "application/json";
      options.body = JSON.stringify(body);
    }

    let isSettled = false;
    const timer = setTimeout(() => {
      if (!isSettled) {
        isSettled = true;
        reject(new Error("请求超时"));
      }
    }, REQUEST_TIMEOUT);

    const clientMethod = method.toUpperCase() === "POST" ? $httpClient.post : $httpClient.get;

    clientMethod(options, (error, response, resBody) => {
      if (isSettled) return;
      isSettled = true;
      clearTimeout(timer);

      if (error) return reject(new Error(error));

      const status = Number(response?.status);
      if (status < 200 || status >= 300) return reject(new Error(`HTTP ${status}`));

      try {
        resolve(JSON.parse(resBody));
      } catch (e) {
        reject(new Error("JSON 解析失败"));
      }
    });
  });
}

function wait(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

function escapeHtml(str) {
  return String(str ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

function render(localNet, localTest, testResult, isUdp, cleanRegion, siblingRegions) {
  const operatorMap = {
    ct: { name: "中国电信", latency: "--", loss: "--", status: "🚫 本地无在线探针", color: "#8c8c8c", blocked: false, weight: 0 },
    cu: { name: "中国联通", latency: "--", loss: "--", status: "🚫 本地无在线探针", color: "#8c8c8c", blocked: false, weight: 0 },
    cm: { name: "中国移动", latency: "--", loss: "--", status: "🚫 本地无在线探针", color: "#8c8c8c", blocked: false, weight: 0 }
  };

  if (testResult && Array.isArray(testResult.results)) {
    testResult.results.forEach((item) => {
      const probe = item.probe;
      const opKey = classifyOperator(probe);
      if (opKey === "other") return;

      const stats = item.result?.stats;
      const loss = stats && typeof stats.loss === "number" ? stats.loss : 100;
      const avg = stats && typeof stats.avg === "number" ? stats.avg : null;
      const city = probe.city || "未知地区";
      const probeRegion = cleanRegionName(probe.region);

      // 判断探针对当前出口网区的归属程度
      const isLocal = probeRegion.toLowerCase() === cleanRegion.toLowerCase() || String(city).toLowerCase().includes(cleanRegion.toLowerCase());
      const isSibling = siblingRegions.map(r => r.toLowerCase()).includes(probeRegion.toLowerCase());

      // 严格限制：非同出口网区的省份探针直接强行过滤、丢弃
      if (!isLocal && !isSibling) return;

      // 权重分配：本地省份探针权重为 2，同出口邻近省份权重为 1
      const currentWeight = isLocal ? 2 : 1;

      let statusText = "";
      let isBlocked = false;
      let uiColor = "";

      const locationLabel = isLocal ? `${city}` : `同出口: ${probeRegion}`;

      if (loss === 100 || avg === null) {
        statusText = `❌ 阻断 (${locationLabel})`;
        isBlocked = true;
        uiColor = "#ff4d4f";
      } else if (loss > 0) {
        statusText = `⚠️ 丢包 ${loss}% (${avg.toFixed(1)}ms - ${locationLabel})`;
        uiColor = "#faad14";
      } else {
        statusText = `✅ 畅通 (${avg.toFixed(1)}ms - ${locationLabel})`;
        uiColor = "#52c41a";
      }

      const candidate = {
        name: operatorMap[opKey].name,
        latency: avg !== null ? `${avg.toFixed(1)}ms` : "--",
        loss: `${loss}%`,
        status: statusText,
        color: uiColor,
        blocked: isBlocked,
        weight: currentWeight
      };

      // 覆盖规则：优先展示本地省份（权重更高），如果没有本地省份则采用同出口邻近省份，若都不是则不显示
      const existing = operatorMap[opKey];
      if (existing.status.startsWith("🚫") || currentWeight > existing.weight) {
        operatorMap[opKey] = candidate;
      }
    });
  }

  let localIsp = "未知运营商";
  let localIp = "未知 IP";
  let localLocStr = "未知地区";
  let userOpCode = "other";

  if (localNet && localNet.status === "success") {
    localIsp = localNet.isp || "未知运营商";
    localIp = localNet.query || "未知 IP";
    localLocStr = `${localNet.regionName || ""} ${localNet.city || ""}`;

    const ispLower = localIsp.toLowerCase();
    if (localIsp.includes("电信") || ispLower.includes("telecom")) userOpCode = "ct";
    else if (localIsp.includes("联通") || ispLower.includes("unicom")) userOpCode = "cu";
    else if (localIsp.includes("移动") || ispLower.includes("mobile")) userOpCode = "cm";
  }

  let feedbackTitle = "📢 诊断结果反馈";
  let feedbackBg = "#f6f8fa";
  let feedbackText = "#24292f";
  let feedbackBorder = "#d0d7de";
  let localFeedbackText = "";

  if (userOpCode === "other") {
    localFeedbackText = "非三大主干运营商宽带，请对照下方测试表。";
  } else {
    const targetOpResult = operatorMap[userOpCode];
    if (targetOpResult.loss === "--") {
      if (localTest.reachable) {
        feedbackTitle = "✅ 本地直连成功";
        feedbackBg = "#dafbe1";
        feedbackText = "#1a7f37";
        feedbackBorder = "#57ab5a";
        localFeedbackText = `物理网卡直连成功 (${localTest.ms}ms)，本地及同出口暂无探测数据。`;
      } else {
        localFeedbackText = `当前本地出口网区内没有【${localIsp}】测速探针在线。`;
      }
    } else if (targetOpResult.blocked) {
      if (localTest.reachable) {
        feedbackTitle = "⚠️ 本地连接不稳定";
        feedbackBg = "#fff8e6";
        feedbackText = "#9a6700";
        feedbackBorder = "#faad14";
        localFeedbackText = `物理网卡握手正常，但同源出口探针反馈阻断，网络质量可能受限。`;
      } else {
        feedbackTitle = "🛑 本地已被阻断";
        feedbackBg = "#ffebe9";
        feedbackText = "#cf222e";
        feedbackBorder = "#ff8182";
        localFeedbackText = `该节点在您当前的【${localIsp}】网络下无法直连。`;
      }
    } else if (targetOpResult.loss !== "0%") {
      feedbackTitle = "⚠️ 本地网络丢包";
      feedbackBg = "#fff8e6";
      feedbackText = "#9a6700";
      feedbackBorder = "#faad14";
      localFeedbackText = `存在轻微丢包 (${targetOpResult.loss})，建议观察。`;
    } else {
      feedbackTitle = "✅ 本地连接良好";
      feedbackBg = "#dafbe1";
      feedbackText = "#1a7f37";
      feedbackBorder = "#57ab5a";
      localFeedbackText = `该节点在您的本地网络下十分畅通。`;
    }
  }

  let diagnosis = "未知";
  const countBlocked = (operatorMap.ct.blocked ? 1 : 0) + (operatorMap.cu.blocked ? 1 : 0) + (operatorMap.cm.blocked ? 1 : 0);
  const countUntested = (operatorMap.ct.loss === "--" ? 1 : 0) + (operatorMap.cu.loss === "--" ? 1 : 0) + (operatorMap.cm.loss === "--" ? 1 : 0);

  if (localTest.reachable) {
    diagnosis = "真机实测连接成功，对您当前网络完全可用。部分探针阻断暂不影响您的真机直连。";
  } else if (isUdp && countBlocked === 0 && countUntested < 3) {
    diagnosis = "UDP IP 在您本地出口网区内通畅，路由正常，可放心连接。";
  } else if (countBlocked === 3 - countUntested && countUntested < 3) {
    diagnosis = "同源物理出口全部无响应，节点可能已离线或被物理封锁。";
  } else if (countBlocked > 0) {
    diagnosis = "同出口网区运营商存在部分差异阻断。建议根据本地网接入情况进行选择。";
  } else if (countBlocked === 0 && countUntested < 3) {
    diagnosis = "当前节点在您所处的出海物理网区连通性良好，未见屏蔽。";
  } else {
    diagnosis = "因同出口网区省份探针全部缺席，无法出具完整的连通诊断报告。";
  }

  const textReport = [
    `【当前节点】: ${nodeName}`,
    `【真机物理网络】: ${localLocStr} ${localIsp}`,
    `【协议模式】: ${isUdp ? "Hysteria 2 / TUIC (UDP)" : "普通 (TCP)"}`,
    `【本机直连实测】: ${isUdp ? "UDP 免除检测" : (localTest.reachable ? `${localTest.ms}ms` : "超时")}`,
    `\n【运营商检测结果】`,
    ` ├ 中国电信: ${operatorMap.ct.status}`,
    ` ├ 中国联通: ${operatorMap.cu.status}`,
    ` └ 中国移动: ${operatorMap.cm.status}`,
    `\n【综合诊断结论】\n${diagnosis}`
  ].join("\n");

  const htmlReport = `
  <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 14px; line-height: 1.5; color: inherit; word-break: break-all;">
    
    <!-- 本地网络识别 -->
    <div style="background-color: rgba(140, 140, 140, 0.05); border-radius: 8px; padding: 12px; margin-bottom: 12px; border: 1px solid rgba(140, 140, 140, 0.15);">
      <div style="font-weight: bold; font-size: 14px; margin-bottom: 4px;">📱 本地真机网卡识别</div>
      <div style="font-size: 13px; opacity: 0.9;">
        <div><b>地理位置</b>: ${escapeHtml(localLocStr)}</div>
        <div><b>网络宽带</b>: <span style="color: #467fcf; font-weight: bold;">${escapeHtml(localIsp)}</span></div>
        <div><b>真机 IP</b>: <code style="font-family: monospace;">${escapeHtml(localIp)}</code></div>
      </div>
    </div>

    <!-- 匹配本地运营商反馈 -->
    <div style="background-color: ${feedbackBg}; color: ${feedbackText}; border-radius: 8px; padding: 12px; margin-bottom: 12px; border-left: 5px solid ${feedbackBorder};">
      <div style="font-weight: bold; font-size: 14px; margin-bottom: 2px;">${feedbackTitle}</div>
      <div style="font-size: 13px; opacity: 0.95;">${localFeedbackText}</div>
    </div>

    <!-- 运营商检测结果 -->
    <div style="border-radius: 8px; border: 1px solid rgba(140, 140, 140, 0.15); overflow: hidden; margin-bottom: 12px;">
      <div style="background-color: rgba(140, 140, 140, 0.08); font-weight: bold; padding: 8px 12px; font-size: 14px; border-bottom: 1px solid rgba(140, 140, 140, 0.15);">🇨🇳 本地出口网区阻断检测 (${isUdp ? "ICMP" : "TCP端口"})</div>
      
      <div style="padding: 10px 12px; border-bottom: 1px solid rgba(140, 140, 140, 0.08); display: flex; justify-content: space-between; align-items: center;">
        <span style="font-weight: bold; color: inherit;">中国电信 (${isUdp ? "ICMP" : "AS4134"})</span>
        <span style="color: ${operatorMap.ct.color}; font-weight: bold; font-size: 13px;">${operatorMap.ct.status}</span>
      </div>
      
      <div style="padding: 10px 12px; border-bottom: 1px solid rgba(140, 140, 140, 0.08); display: flex; justify-content: space-between; align-items: center;">
        <span style="font-weight: bold; color: inherit;">中国联通 (${isUdp ? "ICMP" : "AS4837"})</span>
        <span style="color: ${operatorMap.cu.color}; font-weight: bold; font-size: 13px;">${operatorMap.cu.status}</span>
      </div>
      
      <div style="padding: 10px 12px; display: flex; justify-content: space-between; align-items: center;">
        <span style="font-weight: bold; color: inherit;">中国移动 (${isUdp ? "ICMP" : "AS9808"})</span>
        <span style="color: ${operatorMap.cm.color}; font-weight: bold; font-size: 13px;">${operatorMap.cm.status}</span>
      </div>
    </div>

    <!-- 协议说明及真机反馈 -->
    <div style="background-color: rgba(140, 140, 140, 0.03); border-radius: 8px; padding: 12px; border: 1px solid rgba(140, 140, 140, 0.15); margin-bottom: 12px;">
      <div style="font-size: 13px; color: inherit; opacity: 0.9;">
        ${isUdp 
          ? "<b>UDP 协议 (Hysteria 2 / TUIC)</b>: 已自动免除本地 TCP 握手检测，改由三网 IP 探测。" 
          : `<b>TCP 协议直接测试</b>: 本地物理网卡直接握手：${localTest.reachable ? `<span style="color: #52c41a; font-weight: bold;">成功 (${localTest.ms}ms)</span>` : '<span style="color: #ff4d4f; font-weight: bold;">超时 (Timeout)</span>'}`
        }
      </div>
    </div>

    <!-- 综合诊断结论 -->
    <div style="background-color: rgba(140, 140, 140, 0.03); border-radius: 8px; padding: 12px; border: 1px solid rgba(140, 140, 140, 0.15);">
      <div style="font-weight: bold; margin-bottom: 2px;">📋 综合诊断结论</div>
      <div style="font-size: 13px; color: inherit; opacity: 0.9;">${diagnosis}</div>
    </div>
  </div>
  `;

  $done({
    title: "🌐 本地运营商阻断检测报告",
    content: textReport,
    htmlMessage: htmlReport
  });
}

function finishError(message) {
  $done({
    title: "🌐 阻断检测失败",
    content: `🛑 ${message}`,
    htmlMessage: `<div style="font-family: -apple-system, sans-serif; font-size: 15px; color: inherit;"><b>🛑 ${escapeHtml(message)}</b></div>`
  });
}