/**
 * 本地运营商阻断检测 · Loon generic 脚本 (暗黑全面白字修复版)
 *
 * 使用: 在 Loon 的节点页面对目标执行「运营商阻断查询」
 * 
 * @Author: RavelloH, RuCu6
 * @Modifier: Gemini
 * @Updated: 2026-10-18
 *
 * ===== Loon =====
 * [Script]
 * generic script-path=https://raw.githubusercontent.com/6otho/Loon_tool/refs/heads/main/Script/Carrier-blocking-test.scripts, tag=运营商阻断查询, timeout=60, img-url=https://raw.githubusercontent.com/tugepaopao/Image-Storage/master/cartoon/Cute1/1644010.png
 */

const IP_API = "http://ip-api.com/json";
const GLOBALPING_API = "https://api.globalping.io/v1/measurements";
const REQUEST_TIMEOUT = 10000; 

const params = typeof $environment !== "undefined" && $environment.params ? $environment.params : {};
const nodeName = params.node || "";
const nodeInfo = params.nodeInfo || {};

if (!nodeName) {
  finishError("未获取到节点名称，请长按具体节点运行此脚本。");
} else {
  run();
}

async function run() {
  try {
    const nodeType = String(nodeInfo?.type || "").toLowerCase();
    const nodeNameLower = String(nodeName).toLowerCase();
    const isUdpProtocol = 
      nodeType.includes("hysteria") || nodeType.includes("hy") || nodeType.includes("tuic") || 
      nodeNameLower.includes("hy2") || nodeNameLower.includes("hysteria") || nodeNameLower.includes("tuic");

    // 并行执行：1. 获取当前宽带信息  2. Loon真机内核代理测速
    const [localNetZh, localNetEn, localTest] = await Promise.all([
      requestJson(`${IP_API}?lang=zh-CN`, "DIRECT").catch(() => null),
      requestJson(IP_API, "DIRECT").catch(() => null),
      testNativeProxy(nodeName)
    ]);

    const localRegionEn = getRegionEn(localNetZh?.regionName, localNetEn?.regionName);

    // 请求省内与核心城市探针数据 (多节点并发防连坐)
    const testResult = await runProvinceCheck(nodeInfo, localRegionEn, isUdpProtocol);

    render(localNetZh || localNetEn, localTest, testResult, isUdpProtocol, localRegionEn);
  } catch (error) {
    finishError(`执行异常: ${error.message}`);
  }
}

// === 1. Loon 原生内核代理测速 ===
function testNativeProxy(targetNodeName) {
  return new Promise((resolve) => {
    const startTime = Date.now();
    let isSettled = false;

    const timer = setTimeout(() => {
      if (!isSettled) {
        isSettled = true;
        resolve({ reachable: false, error: "超时", ms: Date.now() - startTime });
      }
    }, 4500);

    $httpClient.get({
      url: "http://cp.cloudflare.com/generate_204",
      node: targetNodeName, 
      headers: { "User-Agent": "Loon-Proxy-Test" }
    }, (error, response) => {
      if (isSettled) return;
      isSettled = true;
      clearTimeout(timer);
      
      const ms = Date.now() - startTime;
      if (error || !response) {
        resolve({ reachable: false, error: "不通", ms });
      } else {
        resolve({ reachable: true, ms });
      }
    });
  });
}

// === 2. 优化并发探针抓取 ===
async function runProvinceCheck(info, localRegion, isUdp) {
  const address = info?.address ? String(info.address) : "";
  const port = info?.port ? Number(info.port) : 443;

  let target = address;
  if (target.startsWith("[") && target.endsWith("]")) {
    target = target.slice(1, -1);
  }

  const cityMap = {
    "Guangdong": ["Shenzhen", "Guangzhou", "Dongguan", "Foshan"],
    "Guangxi": ["Nanning", "Guilin"],
    "Fujian": ["Fuzhou", "Xiamen", "Quanzhou"],
    "Zhejiang": ["Hangzhou", "Ningbo", "Wenzhou"],
    "Jiangsu": ["Nanjing", "Suzhou", "Wuxi"],
    "Shandong": ["Jinan", "Qingdao"],
    "Sichuan": ["Chengdu", "Mianyang"],
    "Hubei": ["Wuhan", "Yichang"],
    "Hunan": ["Changsha", "Zhuzhou"],
    "Henan": ["Zhengzhou", "Luoyang"],
    "Hebei": ["Shijiazhuang", "Baoding"],
    "Liaoning": ["Shenyang", "Dalian"],
    "Anhui": ["Hefei", "Wuhu"],
    "Jiangxi": ["Nanchang", "Ganzhou"],
    "Shaanxi": ["Xi'an", "Xianyang"],
    "Chongqing": ["Chongqing"],
    "Beijing": ["Beijing"],
    "Shanghai": ["Shanghai"],
    "Tianjin": ["Tianjin"]
  };

  const independentQueries = [];
  independentQueries.push([{ country: "CN", magic: localRegion, limit: 3 }]);
  independentQueries.push([{ country: "CN", magic: localRegion, asn: 4134, limit: 2 }]);
  independentQueries.push([{ country: "CN", magic: localRegion, asn: 4837, limit: 2 }]);
  independentQueries.push([{ country: "CN", magic: localRegion, asn: 9808, limit: 2 }]);
  
  const cities = cityMap[localRegion] || [];
  if (cities[0]) independentQueries.push([{ country: "CN", magic: cities[0], limit: 2 }]);
  if (cities[1]) independentQueries.push([{ country: "CN", magic: cities[1], limit: 2 }]);

  const tasks = independentQueries.map(async (locArray) => {
    const body = {
      target: target,
      type: "ping",
      locations: locArray,
      measurementOptions: { packets: 3 }
    };
    if (!isUdp) {
      body.measurementOptions.protocol = "tcp";
      body.measurementOptions.port = port;
    }

    try {
      const submission = await requestJson(GLOBALPING_API, "DIRECT", "POST", body);
      if (submission?.id) {
        return await pollGlobalpingResult(submission.id);
      }
    } catch (e) {
      return null;
    }
  });

  const results = await Promise.all(tasks);
  
  const mergedResult = { results: [] };
  results.forEach(res => {
    if (res && Array.isArray(res.results)) {
      mergedResult.results.push(...res.results);
    }
  });

  return mergedResult;
}

function getRegionEn(zhRegion, enRegion) {
  let zh = String(zhRegion || "");
  if (zh.includes("广东")) return "Guangdong";
  if (zh.includes("广西")) return "Guangxi";
  if (zh.includes("福建")) return "Fujian";
  if (zh.includes("海南")) return "Hainan";
  if (zh.includes("北京")) return "Beijing";
  if (zh.includes("上海")) return "Shanghai";
  if (zh.includes("浙江")) return "Zhejiang";
  if (zh.includes("江苏")) return "Jiangsu";
  if (zh.includes("山东")) return "Shandong";
  if (zh.includes("安徽")) return "Anhui";
  if (zh.includes("江西")) return "Jiangxi";
  if (zh.includes("湖南")) return "Hunan";
  if (zh.includes("湖北")) return "Hubei";
  if (zh.includes("河南")) return "Henan";
  if (zh.includes("河北")) return "Hebei";
  if (zh.includes("山西")) return "Shanxi";
  if (zh.includes("陕西")) return "Shaanxi";
  if (zh.includes("四川")) return "Sichuan";
  if (zh.includes("重庆")) return "Chongqing";
  if (zh.includes("贵州")) return "Guizhou";
  if (zh.includes("云南")) return "Yunnan";
  if (zh.includes("辽宁")) return "Liaoning";
  if (zh.includes("吉林")) return "Jilin";
  if (zh.includes("黑龙江")) return "Heilongjiang";
  if (zh.includes("内蒙")) return "Inner Mongolia"; 
  if (zh.includes("新疆")) return "Xinjiang";
  if (zh.includes("西藏")) return "Tibet";
  if (zh.includes("青海")) return "Qinghai";
  if (zh.includes("甘肃")) return "Gansu";
  if (zh.includes("宁夏")) return "Ningxia";
  if (zh.includes("台湾")) return "Taiwan";
  if (zh.includes("香港")) return "Hong Kong";
  if (zh.includes("澳门")) return "Macau";

  if (enRegion) {
    let clean = String(enRegion).replace(/Province|State|City|Autonomous Region/gi, "").trim();
    if (clean) return clean;
  }
  return "Guangdong"; 
}

async function pollGlobalpingResult(id) {
  const url = `${GLOBALPING_API}/${id}`;
  let attempts = 0;
  while (attempts < 5) {
    await wait(1800);
    const res = await requestJson(url, "DIRECT");
    if (res && res.status !== "in_progress") return res;
    attempts++;
  }
  return await requestJson(url, "DIRECT");
}

function classifyOperator(probe) {
  const asn = Number(probe.asn);
  const net = String(probe.network || "").toLowerCase();
  if ([4134, 4809, 23724, 38283, 134764, 134760].includes(asn) || net.includes("telecom") || net.includes("电信") || net.includes("chinatelecom")) return "ct";
  if ([4837, 9929, 10099, 17621, 17622].includes(asn) || net.includes("unicom") || net.includes("联通") || net.includes("chinaunicom")) return "cu";
  if ([9808, 58453, 56040, 56041, 56042, 56044, 24400].includes(asn) || net.includes("mobile") || net.includes("移动") || net.includes("chinamobile")) return "cm";
  return "other";
}

function requestJson(url, node, method = "GET", body = null) {
  return new Promise((resolve, reject) => {
    const options = { url, headers: { "Accept": "application/json" } };
    if (node) options.node = node;
    if (method.toUpperCase() === "POST" && body) {
      options.headers["Content-Type"] = "application/json";
      options.body = JSON.stringify(body);
    }
    const timer = setTimeout(() => reject(new Error("超时")), REQUEST_TIMEOUT);
    const clientMethod = method.toUpperCase() === "POST" ? $httpClient.post : $httpClient.get;

    clientMethod(options, (error, response, resBody) => {
      clearTimeout(timer);
      if (error) return reject(new Error(error));
      try { resolve(JSON.parse(resBody)); } catch (e) { reject(new Error("JSON 错误")); }
    });
  });
}

function wait(ms) { return new Promise((resolve) => setTimeout(resolve, ms)); }
function escapeHtml(str) { return String(str ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }

function render(localNet, localTest, testResult, isUdp, localRegionEn) {
  const opData = {
    ct: { name: "电信", probes: [] },
    cu: { name: "联通", probes: [] },
    cm: { name: "移动", probes: [] }
  };

  if (testResult && Array.isArray(testResult.results)) {
    testResult.results.forEach((item) => {
      const opKey = classifyOperator(item.probe);
      if (opKey === "other") return;
      const loss = item.result?.stats?.loss ?? 100;
      const avg = item.result?.stats?.avg ?? null;
      const city = item.probe.city || "本省";
      opData[opKey].probes.push({ loss, avg, city });
    });
  }

  let blockedCount = 0;
  let activeProbeOps = 0;

  function evaluateOperator(opInfo) {
    if (!opInfo.probes.length) {
      return { html: `<span class="sub-text">🚫 平台暂无本省机器</span>`, status: "none" };
    }
    activeProbeOps++;
    const total = opInfo.probes.length;
    const okProbes = opInfo.probes.filter(p => p.loss < 100 && p.avg !== null);
    
    // 全阻断
    if (okProbes.length === 0) {
      blockedCount++;
      return { html: `<span style="color:#ff4d4f; font-weight:bold;">❌ 阻断 (${total}节点全丢包)</span>`, status: "blocked" };
    }
    
    // 全畅通
    const minAvg = Math.min(...okProbes.map(p => p.avg));
    const cities = [...new Set(okProbes.map(p => p.city))].slice(0, 2).join("/");
    if (okProbes.length === total) {
      const avgLoss = Math.round(okProbes.reduce((a, b) => a + b.loss, 0) / total);
      if (avgLoss > 0) {
        return { html: `<span style="color:#faad14; font-weight:bold;">⚠️ 丢包 ${avgLoss}% (${minAvg.toFixed(0)}ms · ${cities})</span>`, status: "warn" };
      }
      return { html: `<span style="color:#52c41a; font-weight:bold;">✅ 畅通 (${minAvg.toFixed(0)}ms · ${cities})</span>`, status: "pass" };
    }

    // 局部丢包/阻断
    return { html: `<span style="color:#faad14; font-weight:bold;">⚠️ 局部阻断 (${okProbes.length}/${total}通 · ${minAvg.toFixed(0)}ms)</span>`, status: "warn" };
  }

  const ctRes = evaluateOperator(opData.ct);
  const cuRes = evaluateOperator(opData.cu);
  const cmRes = evaluateOperator(opData.cm);

  let localIsp = "未知运营商", localLocStr = "未知地区";
  if (localNet && localNet.status === "success") {
    localIsp = localNet.isp || "未知运营商";
    localLocStr = `${localNet.regionName || ""} ${localNet.city || ""}`;
  }

  let feedbackTitle = "";
  let feedbackClass = "";
  let localFeedbackText = "";

  if (localTest.reachable) {
    if (blockedCount > 0) {
      feedbackTitle = "🟡 本地直连正常 · 省内存在局部运营商阻断";
      feedbackClass = "status-warn";
      localFeedbackText = `当前节点在你的 <b>${localIsp}</b> 网络下通畅，但同省检测到有其他运营商被阻断。如切换热点/宽带可能无法使用。`;
    } else {
      feedbackTitle = "🟢 本地测试通畅 · 省内三网正常";
      feedbackClass = "status-success";
      localFeedbackText = `该节点在你的 <b>${localIsp}</b> 网络下正常工作，已通过 Loon 原生内核验证。`;
    }
  } else {
    if (activeProbeOps > 0 && blockedCount === activeProbeOps) {
      feedbackTitle = "🔴 全省性防火墙严重阻断";
      feedbackClass = "status-error";
      localFeedbackText = `节点在你的 <b>${localIsp}</b> 及本省探针下全军覆没，属于典型的 IP/SNI/端口 封锁或节点彻底宕机。`;
    } else if (activeProbeOps > 0 && blockedCount < activeProbeOps) {
      feedbackTitle = "🟠 单向阻断 · 仅当前宽带运营商受阻";
      feedbackClass = "status-warn";
      localFeedbackText = `你的 <b>${localIsp}</b> 无法连接该节点，但省内其他运营商测试可通！可尝试切换流量或使用备用运营商连接。`;
    } else {
      feedbackTitle = "🔴 本地当前网络无法直连";
      feedbackClass = "status-error";
      localFeedbackText = `该节点在你的 <b>${localIsp}</b> 网络下连接超时，可能已被阻断或节点离线。`;
    }
  }

  if (isUdp) {
    localFeedbackText += "<br/><small class='udp-tip'>注：此为 UDP 协议。部分节点服务端默认禁 Ping，可能导致下方探针亮红灯，<b>请以本地实测结果为准</b>。</small>";
  }

  const htmlReport = `
  <!doctype html>
  <html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
    <style>
      :root {
        color-scheme: light dark;
        --text-main: #24292f;
        --text-sub: #777777;
        --brand-blue: #0969da;
        --card-bg: rgba(0, 0, 0, 0.04);
        --card-border: rgba(0, 0, 0, 0.1);
        --card-divider: rgba(0, 0, 0, 0.06);

        --succ-bg: #dafbe1;
        --succ-border: #57ab5a;
        --succ-title: #1a7f37;
        --succ-body: #1a7f37;

        --warn-bg: #fff8c5;
        --warn-border: #d4a72c;
        --warn-title: #9a6700;
        --warn-body: #6e4b00;

        --err-bg: #ffebe9;
        --err-border: #ff8182;
        --err-title: #cf222e;
        --err-body: #cf222e;
      }

      /* 亮色模式默认色彩 */
      body {
        margin: 0;
        padding: 4px 0;
        font-family: -apple-system, sans-serif;
        font-size: 14px;
        line-height: 1.5;
        color: var(--text-main);
        -webkit-user-select: none;
      }
      .card-box {
        background: var(--card-bg);
        border-radius: 8px;
        padding: 10px 12px;
        margin-bottom: 12px;
      }
      .net-label, .net-value {
        color: var(--text-main);
      }
      .brand-name {
        color: var(--brand-blue);
        font-weight: bold;
      }
      .status-card {
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 12px;
      }
      .status-success {
        background: var(--succ-bg);
        border-left: 5px solid var(--succ-border);
      }
      .status-success .status-title { color: var(--succ-title); }
      .status-success .status-body { color: var(--succ-body); }

      .status-warn {
        background: var(--warn-bg);
        border-left: 5px solid var(--warn-border);
      }
      .status-warn .status-title { color: var(--warn-title); }
      .status-warn .status-body { color: var(--warn-body); }

      .status-error {
        background: var(--err-bg);
        border-left: 5px solid var(--err-border);
      }
      .status-error .status-title { color: var(--err-title); }
      .status-error .status-body { color: var(--err-body); }

      .status-title {
        font-weight: bold;
        font-size: 15px;
        margin-bottom: 4px;
      }
      .status-body {
        font-size: 13px;
      }
      .sub-text {
        color: var(--text-sub);
      }
      .udp-tip {
        color: var(--text-sub);
        margin-top: 5px;
        display: block;
        font-size: 11px;
      }
      .table-box {
        border-radius: 8px;
        border: 1px solid var(--card-border);
        overflow: hidden;
      }
      .table-header {
        background: var(--card-bg);
        font-weight: bold;
        padding: 8px 12px;
        font-size: 13px;
        border-bottom: 1px solid var(--card-border);
        color: var(--text-main);
      }
      .table-row {
        padding: 10px 12px;
        border-bottom: 1px solid var(--card-divider);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .table-row:last-child {
        border-bottom: none;
      }
      .carrier-name {
        color: var(--text-main);
        font-weight: bold;
      }

      /* 暗黑模式：直接命中类名，强行反白 */
      @media (prefers-color-scheme: dark) {
        :root {
          --card-bg: rgba(255, 255, 255, 0.1) !important;
          --card-border: rgba(255, 255, 255, 0.18) !important;
          --card-divider: rgba(255, 255, 255, 0.1) !important;

          --succ-bg: rgba(46, 160, 67, 0.22) !important;
          --succ-border: #3fb950 !important;
          --succ-title: #3fb950 !important;
          --succ-body: #ffffff !important;

          --warn-bg: rgba(210, 153, 34, 0.22) !important;
          --warn-border: #d29922 !important;
          --warn-title: #f0883e !important;
          --warn-body: #ffffff !important;

          --err-bg: rgba(248, 81, 73, 0.22) !important;
          --err-border: #f85149 !important;
          --err-title: #ff7b72 !important;
          --err-body: #ffffff !important;
        }

        /* 重点：归属行、本省拨测标题、电信/联通/移动、小字全部强制纯白 */
        body,
        .net-label,
        .net-value,
        .table-header,
        .carrier-name,
        .sub-text,
        .udp-tip {
          color: #ffffff !important;
        }

        .brand-name {
          color: #58a6ff !important;
        }
      }
    </style>
  </head>
  <body>
    <!-- 物理网络状态 (归属与宽带) -->
    <div class="card-box">
      <div style="font-size: 13px;">
        <b class="net-label">归属:</b> <span class="net-value">${escapeHtml(localLocStr)}</span> 
        <span class="net-label" style="opacity: 0.6;"> | </span> 
        <b class="net-label">宽带:</b> <span class="brand-name">${escapeHtml(localIsp)}</span>
      </div>
    </div>

    <!-- 核心综合诊断结论 (抬头运营商阻断) -->
    <div class="status-card ${feedbackClass}">
      <div class="status-title">${feedbackTitle}</div>
      <div class="status-body">${localFeedbackText}</div>
    </div>

    <!-- 省内三网情况表 (表头与电信/联通/移动) -->
    <div class="table-box">
      <div class="table-header">🇨🇳 本省拨测分析 ${isUdp ? "(ICMP Ping)" : "(TCP 端口)"}</div>
      <div class="table-row">
        <span class="carrier-name">本省电信</span> <span style="font-size: 13px;">${ctRes.html}</span>
      </div>
      <div class="table-row">
        <span class="carrier-name">本省联通</span> <span style="font-size: 13px;">${cuRes.html}</span>
      </div>
      <div class="table-row">
        <span class="carrier-name">本省移动</span> <span style="font-size: 13px;">${cmRes.html}</span>
      </div>
    </div>
  </body>
  </html>`;

  $done({
    title: "🌐 运营商阻断检测报告",
    content: "请在支持 HTML 的视图查看完整内容。",
    htmlMessage: htmlReport
  });
}

function finishError(message) {
  const errHtml = `
  <!doctype html>
  <html>
  <head>
    <meta charset="utf-8">
    <meta name="color-scheme" content="light dark">
    <style>
      :root { --text-main: #24292f; }
      @media (prefers-color-scheme: dark) { :root { --text-main: #ffffff !important; } }
      body { margin: 0; padding: 6px 0; font-family: -apple-system, sans-serif; color: var(--text-main); font-size: 14px; }
    </style>
  </head>
  <body>
    <b>🛑 ${escapeHtml(message)}</b>
  </body>
  </html>`;

  $done({ 
    title: "🌐 检测失败", 
    content: `🛑 ${message}`, 
    htmlMessage: errHtml 
  });
}