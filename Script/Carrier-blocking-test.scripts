/**
 * 本地运营商阻断检测 · Loon generic 脚本
 *
 * 使用: 在 Loon 的节点页面对目标执行「运营商阻断查询」
 * 
 * @Author: RavelloH, RuCu6
 * @Modifier: Gemini
 * @Updated: 2026-07-17
 *
 * ===== Loon =====
 * [Script]
 * generic script-path=https://raw.githubusercontent.com/6otho/Loon_tool/refs/heads/main/Script/Carrier-blocking-test.scripts, tag=运营商阻断查询, timeout=60, img-url=https://raw.githubusercontent.com/tugepaopao/Image-Storage/master/cartoon/Cute1/1644010.png
 */

const IP_API = "http://ip-api.com/json";
const GLOBALPING_API = "https://api.globalping.io/v1/measurements";
const REQUEST_TIMEOUT = 10000; 

const params = typeof $environment !== "undefined" && $environment.params ? $environment.params : {};
const nodeName = params.node || "";
const nodeInfo = params.nodeInfo || {};

if (!nodeName) {
  finishError("未获取到节点名称，请长按具体节点运行此脚本。");
} else {
  run();
}

async function run() {
  try {
    const nodeType = String(nodeInfo?.type || "").toLowerCase();
    const nodeNameLower = String(nodeName).toLowerCase();
    const isUdpProtocol = 
      nodeType.includes("hysteria") || nodeType.includes("hy") || nodeType.includes("tuic") || 
      nodeNameLower.includes("hy2") || nodeNameLower.includes("hysteria") || nodeNameLower.includes("tuic");

    // 并行执行：1. 获取当前宽带信息  2. Loon真机内核代理测速
    const [localNetZh, localNetEn, localTest] = await Promise.all([
      requestJson(`${IP_API}?lang=zh-CN`, "DIRECT").catch(() => null),
      requestJson(IP_API, "DIRECT").catch(() => null),
      testNativeProxy(nodeName)
    ]);

    const localRegionEn = getRegionEn(localNetZh?.regionName, localNetEn?.regionName);

    // 请求省内与核心城市探针数据 (已彻底重构为防连坐并发模式)
    const testResult = await runProvinceCheck(nodeInfo, localRegionEn, isUdpProtocol);

    render(localNetZh || localNetEn, localTest, testResult, isUdpProtocol, localRegionEn);
  } catch (error) {
    finishError(`执行异常: ${error.message}`);
  }
}

// === 1. Loon 原生内核代理测速 ===
function testNativeProxy(targetNodeName) {
  return new Promise((resolve) => {
    const startTime = Date.now();
    let isSettled = false;

    const timer = setTimeout(() => {
      if (!isSettled) {
        isSettled = true;
        resolve({ reachable: false, error: "超时", ms: Date.now() - startTime });
      }
    }, 4500);

    $httpClient.get({
      url: "http://cp.cloudflare.com/generate_204",
      node: targetNodeName, 
      headers: { "User-Agent": "Loon-Proxy-Test" }
    }, (error, response) => {
      if (isSettled) return;
      isSettled = true;
      clearTimeout(timer);
      
      const ms = Date.now() - startTime;
      if (error || !response) {
        resolve({ reachable: false, error: "不通", ms });
      } else {
        resolve({ reachable: true, ms });
      }
    });
  });
}

// === 2. 并发防连坐探针抓取 (彻底解决 422 报错导致全军覆没的问题) ===
async function runProvinceCheck(info, localRegion, isUdp) {
  const address = info?.address ? String(info.address) : "";
  const port = info?.port ? Number(info.port) : 443;

  let target = address;
  if (target.startsWith("[") && target.endsWith("]")) {
    target = target.slice(1, -1);
  }

  const cityMap = {
    "Guangdong": ["Shenzhen", "Guangzhou", "Dongguan", "Foshan", "Zhuhai"],
    "Guangxi": ["Nanning", "Liuzhou"],
    "Fujian": ["Fuzhou", "Xiamen", "Quanzhou"],
    "Zhejiang": ["Hangzhou", "Ningbo", "Wenzhou"],
    "Jiangsu": ["Nanjing", "Suzhou", "Wuxi"],
    "Shandong": ["Jinan", "Qingdao"],
    "Sichuan": ["Chengdu", "Mianyang"],
    "Hubei": ["Wuhan", "Yichang"],
    "Hunan": ["Changsha", "Zhuzhou"],
    "Henan": ["Zhengzhou", "Luoyang"],
    "Hebei": ["Shijiazhuang", "Baoding"],
    "Liaoning": ["Shenyang", "Dalian"],
    "Anhui": ["Hefei", "Wuhu"],
    "Jiangxi": ["Nanchang", "Ganzhou"],
    "Shaanxi": ["Xi'an", "Xianyang"],
    "Chongqing": ["Chongqing"],
    "Beijing": ["Beijing"],
    "Shanghai": ["Shanghai"],
    "Tianjin": ["Tianjin"]
  };

  // 构造 5 个完全独立的请求条件
  const independentQueries = [];
  
  // 1. 全省盲扫保底 (拿电信)
  independentQueries.push([{ "magic": localRegion, "limit": 3 }]);
  // 2. 单独死磕本省联通 (AS4837)
  independentQueries.push([{ "magic": localRegion, "asn": 4837, "limit": 2 }]);
  // 3. 单独死磕本省移动 (AS9808)
  independentQueries.push([{ "magic": localRegion, "asn": 9808, "limit": 2 }]);
  
  // 4 & 5. 单独死磕本省前两大城市 (如深圳、广州，解决城市名没填省份的问题)
  const cities = cityMap[localRegion] || [];
  if (cities[0]) independentQueries.push([{ "magic": cities[0], "limit": 2 }]);
  if (cities[1]) independentQueries.push([{ "magic": cities[1], "limit": 2 }]);

  // 并发发送这 5 个请求！某一个 422 报错绝不影响其他的成功返回！
  const tasks = independentQueries.map(async (locArray) => {
    const body = {
      target: target,
      type: "ping",
      locations: locArray,
      measurementOptions: { packets: 3 }
    };
    if (!isUdp) {
      body.measurementOptions.protocol = "tcp";
      body.measurementOptions.port = port;
    }

    try {
      const submission = await requestJson(GLOBALPING_API, "DIRECT", "POST", body);
      if (submission?.id) {
        return await pollGlobalpingResult(submission.id);
      }
    } catch (e) {
      // 默默吃掉 422 错误，保证其他成功的请求不受牵连
      return null;
    }
  });

  const results = await Promise.all(tasks);
  
  // 汇总所有成功返回的探针数据
  const mergedResult = { results: [] };
  results.forEach(res => {
    if (res && Array.isArray(res.results)) {
      mergedResult.results.push(...res.results);
    }
  });

  return mergedResult;
}

function getRegionEn(zhRegion, enRegion) {
  let zh = String(zhRegion || "");
  if (zh.includes("广东")) return "Guangdong";
  if (zh.includes("广西")) return "Guangxi";
  if (zh.includes("福建")) return "Fujian";
  if (zh.includes("海南")) return "Hainan";
  if (zh.includes("北京")) return "Beijing";
  if (zh.includes("上海")) return "Shanghai";
  if (zh.includes("浙江")) return "Zhejiang";
  if (zh.includes("江苏")) return "Jiangsu";
  if (zh.includes("山东")) return "Shandong";
  if (zh.includes("安徽")) return "Anhui";
  if (zh.includes("江西")) return "Jiangxi";
  if (zh.includes("湖南")) return "Hunan";
  if (zh.includes("湖北")) return "Hubei";
  if (zh.includes("河南")) return "Henan";
  if (zh.includes("河北")) return "Hebei";
  if (zh.includes("山西")) return "Shanxi";
  if (zh.includes("陕西")) return "Shaanxi";
  if (zh.includes("四川")) return "Sichuan";
  if (zh.includes("重庆")) return "Chongqing";
  if (zh.includes("贵州")) return "Guizhou";
  if (zh.includes("云南")) return "Yunnan";
  if (zh.includes("辽宁")) return "Liaoning";
  if (zh.includes("吉林")) return "Jilin";
  if (zh.includes("黑龙江")) return "Heilongjiang";
  if (zh.includes("内蒙")) return "Inner Mongolia"; 
  if (zh.includes("新疆")) return "Xinjiang";
  if (zh.includes("西藏")) return "Tibet";
  if (zh.includes("青海")) return "Qinghai";
  if (zh.includes("甘肃")) return "Gansu";
  if (zh.includes("宁夏")) return "Ningxia";
  if (zh.includes("台湾")) return "Taiwan";
  if (zh.includes("香港")) return "Hong Kong";
  if (zh.includes("澳门")) return "Macau";

  if (enRegion) {
    let clean = String(enRegion).replace(/Province|State|City|Autonomous Region/gi, "").trim();
    if (clean) return clean;
  }
  return "Guangdong"; 
}

async function pollGlobalpingResult(id) {
  const url = `${GLOBALPING_API}/${id}`;
  let attempts = 0;
  while (attempts < 5) {
    await wait(1800); // 缩短等待间隙，提升并发收集速度
    const res = await requestJson(url, "DIRECT");
    if (res && res.status !== "in_progress") return res;
    attempts++;
  }
  return await requestJson(url, "DIRECT");
}

function classifyOperator(probe) {
  const asn = Number(probe.asn);
  const net = String(probe.network).toLowerCase();
  if (asn === 4134 || asn === 4809 || net.includes("telecom") || net.includes("电信")) return "ct";
  if (asn === 4837 || asn === 9929 || net.includes("unicom") || net.includes("联通")) return "cu";
  if (asn === 9808 || asn === 58453 || net.includes("mobile") || net.includes("移动")) return "cm";
  return "other";
}

function requestJson(url, node, method = "GET", body = null) {
  return new Promise((resolve, reject) => {
    const options = { url, headers: { "Accept": "application/json" } };
    if (node) options.node = node;
    if (method.toUpperCase() === "POST" && body) {
      options.headers["Content-Type"] = "application/json";
      options.body = JSON.stringify(body);
    }
    const timer = setTimeout(() => reject(new Error("超时")), REQUEST_TIMEOUT);
    const clientMethod = method.toUpperCase() === "POST" ? $httpClient.post : $httpClient.get;

    clientMethod(options, (error, response, resBody) => {
      clearTimeout(timer);
      if (error) return reject(new Error(error));
      try { resolve(JSON.parse(resBody)); } catch (e) { reject(new Error("JSON 错误")); }
    });
  });
}

function wait(ms) { return new Promise((resolve) => setTimeout(resolve, ms)); }
function escapeHtml(str) { return String(str ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }

function render(localNet, localTest, testResult, isUdp, localRegionEn) {
  const operatorMap = {
    ct: { name: "电信", status: "🚫 平台暂无本省【电信】机器" },
    cu: { name: "联通", status: "🚫 平台暂无本省【联通】机器" },
    cm: { name: "移动", status: "🚫 平台暂无本省【移动】机器" }
  };

  // 整理并提取汇总后的探针数据
  if (testResult && Array.isArray(testResult.results)) {
    testResult.results.forEach((item) => {
      const opKey = classifyOperator(item.probe);
      if (opKey === "other") return;
      
      const loss = item.result?.stats?.loss ?? 100;
      const avg = item.result?.stats?.avg ?? null;
      const city = item.probe.city || "本省";

      let statusText = loss === 100 || avg === null ? `❌ 阻断 (${city})` : (loss > 0 ? `⚠️ 丢包 ${loss}% (${city})` : `✅ 畅通 (${avg.toFixed(1)}ms - ${city})`);
      
      // 优选逻辑：只要测试出能通的数据，就立刻覆盖之前的报错或空白数据
      if (operatorMap[opKey].status.startsWith("🚫") || operatorMap[opKey].status.includes("阻断") || statusText.startsWith("✅")) {
        operatorMap[opKey].status = `<span style="color: ${loss === 100 ? '#ff4d4f' : (loss > 0 ? '#faad14' : '#52c41a')}; font-weight: bold;">${statusText}</span>`;
      }
    });
  }

  let localIsp = "未知运营商", localLocStr = "未知地区";
  if (localNet && localNet.status === "success") {
    localIsp = localNet.isp || "未知运营商";
    localLocStr = `${localNet.regionName || ""} ${localNet.city || ""}`;
  }

  let feedbackTitle = localTest.reachable ? "🟢 本地当前网络测试通畅" : "🔴 本地当前网络无法直连";
  let feedbackBg = localTest.reachable ? "#dafbe1" : "#ffebe9";
  let feedbackText = localTest.reachable ? "#1a7f37" : "#cf222e";
  let feedbackBorder = localTest.reachable ? "#57ab5a" : "#ff8182";
  let localFeedbackText = localTest.reachable 
    ? `该节点在你的 <b>${localIsp}</b> 网络下正常工作，已通过 Loon 原生内核验证。`
    : `该节点在你的 <b>${localIsp}</b> 网络下连接超时，可能已被阻断或节点离线。`;

  if (isUdp) {
    localFeedbackText += "<br/><small style='color: #666; margin-top: 4px; display: block;'>注：此为 UDP 协议。部分节点服务端默认禁 Ping，可能导致下方省内探针亮红灯，<b>请以本地实测结果为准</b>。</small>";
  }

  const htmlReport = `
  <div style="font-family: -apple-system, sans-serif; font-size: 14px; line-height: 1.5; color: #24292f;">
    
    <!-- 物理网络状态 -->
    <div style="background: rgba(0,0,0,0.03); border-radius: 8px; padding: 10px 12px; margin-bottom: 12px;">
      <div style="font-size: 13px;"><b>归属:</b> ${escapeHtml(localLocStr)} | <b>宽带:</b> <span style="color:#0969da; font-weight:bold;">${escapeHtml(localIsp)}</span></div>
    </div>

    <!-- 核心诊断结论 -->
    <div style="background: ${feedbackBg}; color: ${feedbackText}; border-radius: 8px; padding: 12px; margin-bottom: 12px; border-left: 5px solid ${feedbackBorder};">
      <div style="font-weight: bold; font-size: 15px; margin-bottom: 4px;">${feedbackTitle}</div>
      <div style="font-size: 13px;">${localFeedbackText}</div>
    </div>

    <!-- 省内三网情况表 -->
    <div style="border-radius: 8px; border: 1px solid rgba(0,0,0,0.1); overflow: hidden;">
      <div style="background: rgba(0,0,0,0.04); font-weight: bold; padding: 8px 12px; font-size: 13px; border-bottom: 1px solid rgba(0,0,0,0.1);">🇨🇳 本省及核心城市拨测 ${isUdp ? "(ICMP Ping)" : "(TCP 端口)"}</div>
      <div style="padding: 10px 12px; border-bottom: 1px solid rgba(0,0,0,0.05); display: flex; justify-content: space-between;">
        <b>本省电信</b> <span style="font-size: 13px;">${operatorMap.ct.status}</span>
      </div>
      <div style="padding: 10px 12px; border-bottom: 1px solid rgba(0,0,0,0.05); display: flex; justify-content: space-between;">
        <b>本省联通</b> <span style="font-size: 13px;">${operatorMap.cu.status}</span>
      </div>
      <div style="padding: 10px 12px; display: flex; justify-content: space-between;">
        <b>本省移动</b> <span style="font-size: 13px;">${operatorMap.cm.status}</span>
      </div>
    </div>

  </div>`;

  $done({
    title: "🌐 运营商阻断检测报告",
    content: "请在支持 HTML 的视图查看完整内容。",
    htmlMessage: htmlReport
  });
}

function finishError(message) {
  $done({ title: "🌐 检测失败", content: `🛑 ${message}`, htmlMessage: `<div style="font-family: sans-serif; font-size: 15px;"><b>🛑 ${escapeHtml(message)}</b></div>` });
}