/**
 * 本地运营商阻断检测 · Loon generic 脚本
 *
 * 使用: 在 Loon 的节点页面对目标执行「运营商阻断查询」
 * 
 * @Author: RavelloH, RuCu6
 * @Modifier: Gemini
 * @Updated: 2026-07-17
 *
 * ===== Loon =====
 * [Script]
 * generic script-path=https://raw.githubusercontent.com/6otho/Loon_tool/refs/heads/main/Script/Carrier-blocking-test.scripts, tag=运营商阻断查询, timeout=60, img-url=https://raw.githubusercontent.com/tugepaopao/Image-Storage/master/cartoon/Cute1/1644010.png
 */

const IP_API = "http://ip-api.com/json?lang=zh-CN";
const GLOBALPING_API = "https://api.globalping.io/v1/measurements";
const REQUEST_TIMEOUT = 8000; // 接口请求超时时间
const HANDSHAKE_TIMEOUT = 3000; // 本地真机直接握手检测的超时时间 (3秒)

const params = typeof $environment !== "undefined" && $environment.params ? $environment.params : {};
const nodeName = params.node || "";
const nodeInfo = params.nodeInfo || {};

if (!nodeName) {
  finishError("未获取到节点名称，请长按具体节点运行此脚本。");
} else {
  run();
}

async function run() {
  try {
    // 1. 并行执行：识别本地真实物理网络、执行手机本地到节点的真实连接测试
    const [localNet, localTest] = await Promise.all([
      detectLocalNetwork(),
      testLocalDirectConnection(nodeInfo)
    ]);

    // 2. 如果本地连接失败，启动境外中立节点对照测试，判断是本地阻断还是服务器离线
    let remoteTest = { available: false };
    if (!localTest.reachable) {
      remoteTest = await testRemoteFromOverseas(nodeInfo);
    }

    render(localNet, localTest, remoteTest);
  } catch (error) {
    finishError(`执行异常: ${error.message}`);
  }
}

// === 本地网络环境识别 ===
async function detectLocalNetwork() {
  try {
    const data = await requestJson(IP_API, "DIRECT");
    if (data && data.status === "success") {
      return {
        ok: true,
        ip: data.query || "未知",
        city: data.city || "",
        region: data.regionName || "",
        isp: data.isp || "未知运营商"
      };
    }
    return { ok: false, error: "运营商数据库响应异常" };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

// === 手机本地网卡到节点端口的真实连接探测 ===
function testLocalDirectConnection(info) {
  const address = info?.address ? String(info.address) : "";
  const port = info?.port ? Number(info.port) : null;

  if (!address || !port) {
    return Promise.resolve({ reachable: false, error: "节点配置缺少 IP 或端口" });
  }

  const host = address.includes(":") && !address.startsWith("[") ? `[${address}]` : address;
  const url = `http://${host}:${port}/`;
  const startTime = Date.now();

  return new Promise((resolve) => {
    let isSettled = false;

    // 本地连接超时控制
    const timer = setTimeout(() => {
      if (!isSettled) {
        isSettled = true;
        resolve({ reachable: false, error: "TIMEOUT", ms: Date.now() - startTime });
      }
    }, HANDSHAKE_TIMEOUT);

    $httpClient.get({
      url,
      node: "DIRECT", // 强制使用当前手机物理网卡直连，绕过任何代理组
      headers: { "User-Agent": "LoonLocalHandshakeTest" }
    }, (error, response, body) => {
      if (isSettled) return;
      isSettled = true;
      clearTimeout(timer);

      const ms = Date.now() - startTime;

      if (error) {
        const errStr = String(error).toLowerCase();
        // 握手超时通常意味着数据包在中途被悄悄丢弃（GFW 阻断的常见特征）
        if (errStr.includes("timeout") || errStr.includes("time out")) {
          resolve({ reachable: false, error: "TIMEOUT", ms });
        } else if (errStr.includes("refused")) {
          // 连接被对方主动拒绝（说明 IP 路由可达，但该端口在服务器端未开启或被防火墙拦截）
          resolve({ reachable: true, error: "REFUSED", ms });
        } else {
          // 其他由于协议不匹配导致的错误（如 Reset、Bad response），皆说明 TCP 物理层已成功建立过握手
          resolve({ reachable: true, ms });
        }
      } else {
        // 成功响应说明端口畅通
        resolve({ reachable: true, ms });
      }
    });
  });
}

// === 境外中立节点探测 (Globalping 境外探针) ===
async function testRemoteFromOverseas(info) {
  const address = info?.address ? String(info.address) : "";
  const port = info?.port ? Number(info.port) : 443;

  let target = address;
  if (target.startsWith("[") && target.endsWith("]")) {
    target = target.slice(1, -1);
  }

  const body = {
    target: target,
    type: "ping",
    locations: [{ "magic": "US", "limit": 1 }], // 仅使用 1 个境外的节点
    measurementOptions: {
      packets: 3,
      protocol: "tcp",
      port: port
    }
  };

  try {
    const submission = await requestJson(GLOBALPING_API, "DIRECT", "POST", body);
    if (!submission?.id) return { available: false, error: "任务创建失败" };

    const result = await pollGlobalpingResult(submission.id);
    if (result && Array.isArray(result.results) && result.results.length > 0) {
      const stats = result.results[0].result?.stats;
      const loss = stats && typeof stats.loss === "number" ? stats.loss : 100;
      const avg = stats && typeof stats.avg === "number" ? stats.avg : null;

      if (loss === 100 || avg === null) {
        return { available: true, reachable: false, error: "境外同样不可达" };
      }
      return { available: true, reachable: true, latency: avg };
    }
    return { available: false, error: "未返回有效结果" };
  } catch (e) {
    return { available: false, error: e.message };
  }
}

async function pollGlobalpingResult(id) {
  const url = `${GLOBALPING_API}/${id}`;
  let attempts = 0;
  while (attempts < 4) {
    await wait(1800);
    const res = await requestJson(url, "DIRECT");
    if (res && res.status !== "in_progress") return res;
    attempts++;
  }
  return await requestJson(url, "DIRECT");
}

// === 网络请求通用工具函数 ===
function requestJson(url, node, method = "GET", body = null) {
  return new Promise((resolve, reject) => {
    const options = {
      url,
      headers: {
        Accept: "application/json",
        "User-Agent": "Mozilla/5.0 (iPhone; CPU iPhone OS 16_0 like Mac OS X) AppleWebKit/605.1.15 Loon Network Check"
      }
    };
    if (node) options.node = node;
    if (method.toUpperCase() === "POST" && body) {
      options.headers["Content-Type"] = "application/json";
      options.body = JSON.stringify(body);
    }

    let isSettled = false;
    const timer = setTimeout(() => {
      if (!isSettled) {
        isSettled = true;
        reject(new Error("请求超时"));
      }
    }, REQUEST_TIMEOUT);

    const clientMethod = method.toUpperCase() === "POST" ? $httpClient.post : $httpClient.get;

    clientMethod(options, (error, response, resBody) => {
      if (isSettled) return;
      isSettled = true;
      clearTimeout(timer);

      if (error) return reject(new Error(error));

      const status = Number(response?.status);
      if (status < 200 || status >= 300) return reject(new Error(`HTTP ${status}`));

      try {
        resolve(JSON.parse(resBody));
      } catch (e) {
        reject(new Error("JSON 解析失败"));
      }
    });
  });
}

function wait(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

function escapeHtml(str) {
  return String(str ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

// === UI 渲染及诊断逻辑 ===
function render(localNet, localTest, remoteTest) {
  let statusTitle = "连接诊断报告";
  let statusBg = "#f6f8fa";
  let statusText = "#24292f";
  let statusBorder = "#d0d7de";
  let diagnosisText = "";

  const localIspName = localNet.ok ? localNet.isp : "本地网络";

  if (localTest.reachable) {
    // 手机本地直连通过
    statusTitle = "🟢 本地连接正常";
    statusBg = "#dafbe1";
    statusText = "#1a7f37";
    statusBorder = "#57ab5a";
    diagnosisText = `该节点在您手机当前的物理网络下连通性良好，本地直接握手测试通过（延时约为 ${localTest.ms}ms）。没有检测到来自本地运营商的连接阻断行为。`;
  } else if (!localTest.reachable && remoteTest.available && remoteTest.reachable) {
    // 本地不通，但境外能通 -> 本地运营商阻断
    statusTitle = "🔴 遭到本地运营商阻断";
    statusBg = "#ffebe9";
    statusText = "#cf222e";
    statusBorder = "#ff8182";
    diagnosisText = `境外中立探针检测到该节点运行正常（延迟 ${remoteTest.latency.toFixed(1)}ms）。但您当前手机的真实网卡直连尝试已超时。这是典型的 **${localIspName}** 运营商 QOS、黑洞或 GFW 端口阻断行为。`;
  } else if (!localTest.reachable && remoteTest.available && !remoteTest.reachable) {
    // 本地不通，境外也不通 -> 节点服务器故障/下线
    statusTitle = "⚫ 节点服务器已离线";
    statusBg = "#eaeef2";
    statusText = "#57606a";
    statusBorder = "#afb8c1";
    diagnosisText = "本地手机网卡与境外中立探针均无法与该节点建立连接。该节点服务器极有可能处于关机、离线故障或端口未开放状态。";
  } else {
    // 本地不通，但境外测试未获取到有效数据
    statusTitle = "⚠️ 物理连通超时";
    statusBg = "#fff8e6";
    statusText = "#9a6700";
    statusBorder = "#faad14";
    diagnosisText = "手机当前网络直连握手尝试已超时，因境外比对探针响应异常，无法精细区分属于本地运营商屏蔽还是服务器关机故障。";
  }

  // 纯文本 Fallback 输出
  const textReport = [
    `【当前节点】: ${nodeName}`,
    `【真机物理网络】: ${localNet.ok ? `${localNet.region} ${localNet.city} ${localNet.isp}` : "检测失败"}`,
    `【真机直连延迟】: ${localTest.reachable ? `${localTest.ms}ms` : "超时/阻断"}`,
    `【海外中立测试】: ${remoteTest.available ? (remoteTest.reachable ? `可达 (${remoteTest.latency.toFixed(1)}ms)` : "不可达") : "未执行/超时"}`,
    `\n【诊断结论】\n${diagnosisText}`
  ].join("\n");

  // HTML 卡片渲染
  const htmlReport = `
  <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 14px; line-height: 1.6; color: inherit; word-break: break-all;">
    
    <!-- 1. 真机物理网络卡片 -->
    <div style="background-color: rgba(140, 140, 140, 0.05); border-radius: 8px; padding: 12px; margin-bottom: 12px; border: 1px solid rgba(140, 140, 140, 0.15);">
      <div style="font-weight: bold; font-size: 15px; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">📱 本地真机网卡识别</div>
      <div style="font-size: 13px;">
        <div><b>真实地理位置</b>: ${escapeHtml(localNet.region)} ${escapeHtml(localNet.city)}</div>
        <div><b>物理接入运营商</b>: <span style="color: #467fcf; font-weight: bold;">${escapeHtml(localNet.isp)}</span></div>
        <div><b>真实公网出口 IP</b>: <code style="font-family: monospace;">${escapeHtml(localNet.ip)}</code></div>
      </div>
    </div>

    <!-- 2. 实测双向网络通路 -->
    <div style="border-radius: 8px; border: 1px solid rgba(140, 140, 140, 0.15); overflow: hidden; margin-bottom: 12px;">
      <div style="background-color: rgba(140, 140, 140, 0.08); font-weight: bold; padding: 8px 12px; font-size: 14px; border-bottom: 1px solid rgba(140, 140, 140, 0.15);">🔍 实时网卡握手实测</div>
      
      <!-- 本地物理直连 -->
      <div style="padding: 10px 12px; border-bottom: 1px solid rgba(140, 140, 140, 0.08); display: flex; justify-content: space-between; align-items: center;">
        <span style="font-weight: bold; color: inherit;">本地网卡 ➡️ 节点物理直连</span>
        <span style="color: ${localTest.reachable ? "#52c41a" : "#ff4d4f"}; font-weight: bold; font-size: 13px;">
          ${localTest.reachable ? `✅ 握手成功 (${localTest.ms}ms)` : "❌ 握手超时 (Timeout)"}
        </span>
      </div>
      
      <!-- 境外中立中转 -->
      <div style="padding: 10px 12px; display: flex; justify-content: space-between; align-items: center;">
        <span style="font-weight: bold; color: inherit;">境外探针 ➡️ 节点物理直连</span>
        <span style="color: ${remoteTest.available ? (remoteTest.reachable ? "#52c41a" : "#ff4d4f") : "#8c8c8c"}; font-weight: bold; font-size: 13px;">
          ${remoteTest.available ? (remoteTest.reachable ? `✅ 连通正常 (${remoteTest.latency.toFixed(1)}ms)` : "❌ 响应超时 (Dead)") : "⚪ 跳过/无需检测"}
        </span>
      </div>
    </div>

    <!-- 3. 弹窗警告和诊断反馈 -->
    <div style="background-color: ${statusBg}; color: ${statusText}; border-radius: 8px; padding: 12px; border-left: 5px solid ${statusBorder};">
      <div style="font-weight: bold; font-size: 14px; margin-bottom: 4px;">${statusTitle}</div>
      <div style="font-size: 13px; opacity: 0.9;">${diagnosisText}</div>
    </div>

  </div>
  `;

  $done({
    title: "🌐 本地运营商阻断检测",
    content: textReport,
    htmlMessage: htmlReport
  });
}

function finishError(message) {
  $done({
    title: "🌐 阻断检测失败",
    content: `🛑 ${message}`,
    htmlMessage: `<div style="font-family: -apple-system, sans-serif; font-size: 15px; color: inherit;"><b>🛑 ${escapeHtml(message)}</b></div>`
  });
}