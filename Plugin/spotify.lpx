#!name = Spotify歌词翻译
#!desc = 通过百度翻译API实现歌词汉化，适配Loon 3.5.3+新语法并绕过TUN直连
#!author = 6otho, app2smile
#!icon = https://raw.githubusercontent.com/Orz-3/mini/master/Color/Spotify.png
#!loon_version = 3.5.1(983)
#!date = 2026-10-17
#!type = normal

[Argument]
appid = input,"",type=string,tag=百度appid,desc=此处填写百度appid
securityKey = input,"",type=string,tag=百度密钥,desc=此处填写百度密钥

[General]
# 核心修复：强制百度翻译接口绕过 TUN 走系统原生网络直连，彻底根除 Request timeout
bypass-tun = fanyi-api.baidu.com, api.fanyi.baidu.com
real-ip = fanyi-api.baidu.com, api.fanyi.baidu.com

[Rule]
AND, ((DOMAIN, spclient.wg.spotify.com),   (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN, gae2-spclient.spotify.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN, guc3-spclient.spotify.com), (PROTOCOL, QUIC)), REJECT

[Script]
response if ${url} ~= /^https:\/\/(?:spclient\.wg|gae2-spclient|guc3-spclient)\.spotify\.com(?::443)?\/color-lyrics\/v2\/track\// then script("https://raw.githubusercontent.com/6otho/Loon_tool/main/Js/Spotify_lyrics.js", {${appid}, ${securityKey}}) with requires_body=true, binary_body=true, timeout=30, tag="Spotify歌词汉化"

[Mitm]
hostname = *.spotify.com