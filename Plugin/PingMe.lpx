#!name = PingMe 自动助手
#!desc = 自动签到/刷视频、获取Cookie、免卸载登录与防注销保号。(适配 Loon 3.5.1+ 新语法)
#!author = 6otho
#!icon = https://upicon.iknn.eu.org/admin/pingme1_1779180397938.jpeg
#!tag = 签到, 实用工具
#!system = iOS, iPadOS, macOS
#!loon_version = 3.5.1(983)
#!type = normal

[Argument]
# Cookie 抓取开关 (录入完账号建议关闭，防止日常频繁弹窗/抓包)
enable_cookie = switch,true,tag=开启Cookie捕获,desc=录入账号完毕后建议关闭此开关

[Mitm]
hostname = api.pingmeapp.net

[Script]
# —————————————————————————————————————————————
# 1. 抓取 Cookie 与账号参数
# —————————————————————————————————————————————
request if ${enable_cookie} == true && ${url} ~= /^https?:\/\/api\.pingmeapp\.net\/app\/(?:queryBalanceAndBonus|checkIn)/i then script("https://github.com/6otho/Loon_tool/raw/refs/heads/main/Js/PingMe_GetCookie.js") with tag="PingMe-获取Cookie", timeout=15, requires_body=true

# —————————————————————————————————————————————
# 2. 登录解锁（设备ID伪装）与 拦截注销（退出保号）
# —————————————————————————————————————————————
request if ${url} ~= /^https?:\/\/api\.pingmeapp\.net\/(?:api\/|v1\/|user\/|account\/)?(?:log(?:in)?Out|sign[oO]ut|disconnect|exit|log?in|sign[iI]n|send(?:Code|_code|Sms)|register|signUp|auth\/)/i then script("https://github.com/6otho/Loon_tool/raw/refs/heads/main/Js/PingMe_UnlockLogin.js") with tag="PingMe-解锁登录与拦截退出", timeout=20, requires_body=true

# —————————————————————————————————————————————
# 3. 定时自动签到任务 (每2小时及23点45分执行，注入 23:45 结算参数)
# —————————————————————————————————————————————
cron "45 */2,23 * * *" then script("https://github.com/6otho/Loon_tool/raw/refs/heads/main/Js/PingMe_Task.js", "23:45") with tag="PingMe", img_url="https://upicon.iknn.eu.org/admin/pingme1_1779180397938.jpeg", timeout=1000

# —————————————————————————————————————————————
# 4. 手动一键执行面板 (共享相同图标与 1000s 超时配置)
# —————————————————————————————————————————————
generic then script("https://github.com/6otho/Loon_tool/raw/refs/heads/main/Js/PingMe_Task.js", "23:45") with tag="PingMe-手动签到", img_url="https://upicon.iknn.eu.org/admin/pingme1_1779180397938.jpeg", timeout=1000
