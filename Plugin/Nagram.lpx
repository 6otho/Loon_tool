#!name = Telegram 链接跳转第三方客户端
#!desc = 强制 t.me 网页链接跳转本地第三方 Telegram 客户端。可在 Loon 插件设置中切换跳转的目标客户端。
#!author = Loon
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Telegram.png

[Argument]
client = select,"tg","swiftgram","nicegram","ime","tgx",tag=选择目标客户端,desc=tg(适用于 Nagram/Nekogram/官方)；其余为各第三方客户端

[Rewrite]
^https?:\/\/t\.me\/(.+) ${client}://resolve?domain=$1 307

[Mitm]
hostname = t.me