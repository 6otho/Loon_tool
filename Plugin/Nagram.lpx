#!name = Telegram 链接跳转多客户端
#!desc = 强制 t.me 网页链接跳转本地客户端。可在 Loon 设置中直接选择 Nagram、Swiftgram、Turrit 等。

[Argument]
client = select,"Nagram","Swiftgram","Turrit","原版 Telegram",tag=选择目标客户端,desc=直接选择你要调起的客户端名称

[Script]
http-request ^https?:\/\/t\.me\/(.+) script-path=https://raw.githubusercontent.com/Koolson/Qure/master/Script/Telegram/Telegram_Jump.js,tag=Telegram跳转,argument=[{client}]

[MITM]
hostname = %APPEND% t.me