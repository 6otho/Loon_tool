#!name = Trakt 播放器跳转
#!desc = 在 Trakt 官方客户端的“播放渠道 (Where to Watch)”中原生注入 Infuse 播放器跳转；点击插件图标可直达 Infuse。
#!openUrl = infuse://
#!author = 6otho
#!tag = 影视增强
#!loon_version = 3.2.1
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Trakt.png
#!date = 2026-09-23 20:15:00

[Argument]
# 在 Loon 插件配置面板中可自由选择首选播放器
player = select, "Infuse", "VidHub", "SenPlayer", "Fileball", tag = 首选播放器, desc = 设置在 Trakt 中排在首位的播放器

[Script]
# 拦截 Trakt 的影视详情与播放源接口（注入 Infuse 等播放器）
http-response ^https?:\/\/api\.trakt\.tv\/(movies|shows)\/([^\/?#]+) requires-body=true, max-size=0, script-path=https://raw.githubusercontent.com/6otho/Loon_tool/refs/heads/main/Js/trakt.js, argument=[{player}], tag=Trakt播放源注入

[Mitm]
hostname = api.trakt.tv
